# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details.
# The query param '?retryWrites=true&w=majority' ensures resilient writes across the replica set.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/hotel_reservation?retryWrites=true&w=majority

# JWT Authentication Secret
# Generate a strong 32+ character random secret (e.g., using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin for CORS
CLIENT_URL=http://localhost:5173

